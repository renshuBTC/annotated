{
  "manifest_version": 3,
  "name": "Annotated.com",
  "short_name": "Annotated.com",
  "version": "2.9.6",
  "key": "",
  "description": "Snip or record part of any page, annotate it, save an X-ready PNG or MP4 with its source, and share it in a global chat.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Annotated.com",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Annotated.com: the bar and the chat (again: close them)"
    },
    "record": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Start a video recording of part of the page"
    },
    "open-annotations": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open the chat in the side panel (the bar comes with it)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
